{
  "name": "HKEX: what the venue refuses, and how it says so",

  "begin_string": "FIXT.1.1",
  "fix_port": 9012,
  "control_port": 9102,
  "server_comp_id": "HKEXSIM",
  "logon_reset_flag": false,
  "logon_fields": {"789": "1", "1137": "9", "1400": "101", "1402": "c2ltdWxhdG9y"},

  "sessions": {
    "broker": {"comp_id": "BROKER1"}
  },

  "steps": [
    {"control": "orders.cancel_all", "args": {"text": "scenario setup"}},
    {"control": "session.reset", "args": {"target_comp_id": "BROKER1"}},
    {"control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},

    {"logon": "broker"},
    {"clear": "broker"},

    {"comment": "00700 trades in lots of 100",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "150", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "HK-R1", "150": "8", "39": "8", "103": "13"}},

    {"comment": "above HK$200 the spread is 0.200, so 393.150 is off-tick",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R2",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "393.150",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "HK-R2", "150": "8", "103": "99"}},

    {"comment": "The nominal limit is the 9-times rule, not a spread band:",
     "comment2": "395.800 x 9 = 3562.200, and the spread up there is 2.000",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R3",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "3564.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "HK-R3", "150": "8", "103": "16"}},

    {"comment": "420.000 is 121 spreads out and entirely acceptable to SEHK",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R3B",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "420.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R3B", "150": "0"}},
    {"send": "broker",
     "fields": {"35": "F", "11": "HK-R3C", "41": "HK-R3B",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "54": "1", "38": "100"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R3C", "150": "4"}},

    {"comment": "ExecInst 'c' waives the nominal limit the venue would enforce",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R4", "18": "c",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "4000.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R4", "150": "0"}},

    {"comment": "The quotation rule is anchored on the live BBO instead:",
     "comment2": "with a best bid of 4000.000 the spread is 2.000, so 24",
     "comment3": "spreads behind it is 3952.000 and anything lower is refused",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R4B",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "3950.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "HK-R4B", "150": "8", "103": "16"}},

    {"comment": "An unlisted security never reaches the engine, so OrderID is NONE",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R5",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "99999", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "10.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "HK-R5", "150": "8", "37": "NONE"}},

    {"comment": "Odd lots are a separate, semi-automatic flow this venue omits",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R6", "1093": "1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R6", "150": "8"}},

    {"comment": "A group count that disagrees with the group is a session Reject",
     "send": "broker",
     "fields": {"35": "D", "11": "HK-R7",
                "453": "3", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "3", "373": "16", "371": "453"}},

    {"comment": "A closed segment refuses entry and expires what rests",
     "control": "state.set", "args": {"market": "MAIN", "state": "CLOSED"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R4", "150": "4",
                                    "378": "6"}},

    {"send": "broker",
     "fields": {"35": "D", "11": "HK-R8",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "8", "11": "HK-R8", "150": "8"}},

    {"control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},
    {"control": "orders.cancel_all", "args": {"text": "scenario teardown"}},
    {"logout": "broker"}
  ]
}
