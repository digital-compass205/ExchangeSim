{
  "name": "HKEX: the binary encoding of OCG-C, on its own port",

  "protocol": "binary",
  "begin_string": "FIXT.1.1",
  "fix_port": 9011,
  "control_port": 9102,
  "server_comp_id": "HKEXSIM",
  "logon_reset_flag": false,
  "logon_fields": {"789": "1", "1402": "c2ltdWxhdG9y"},

  "sessions": {
    "broker": {"comp_id": "BROKER3"},
    "fixbroker": {"comp_id": "BROKER1", "protocol": "fix", "port": 9012,
                  "logon_fields": {"789": "1", "1137": "9", "1400": "101",
                                   "1402": "c2ltdWxhdG9y"}}
  },

  "steps": [
    {"comment": "Steps are written in FIX tags whichever encoding carries them:",
     "control": "session.reset", "args": {"target_comp_id": "BROKER3"}},
    {"comment": "the wire differs, the protocol does not.",
     "control": "session.reset", "args": {"target_comp_id": "BROKER1"}},
    {"control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},

    {"comment": "The binary Logon carries no EncryptMethod and no HeartBtInt",
     "logon": "broker"},
    {"clear": "broker"},

    {"comment": "The startup handshake: what may this client's brokers do?",
     "send": "broker", "fields": {"35": "CU", "1770": "800102"}},
    {"comment": "One report per Broker ID, the last carrying LastFragment,",
     "expect": "broker",
     "fields": {"35": "CV", "1770": "800102", "1511": "0", "1512": "1",
                "893": "Y", "1691": "1003", "1773": "1", "1775": "0",
                "1774": "Y"}},
    {"comment": "and the same answer to a FIX client, in its own encoding",
     "logon": "fixbroker"},
    {"clear": "fixbroker"},
    {"send": "fixbroker", "fields": {"35": "CU", "1770": "800103"}},
    {"expect": "fixbroker",
     "fields": {"35": "CV", "1770": "800103", "1691": "1001", "1772": "1",
                "1671": "1", "1693": "1"}},

    {"comment": "A board-lot limit order. Parties and Disclosure are flat",
     "send": "broker",
     "fields": {"35": "D", "11": "BIN-A1",
                "453": "2", "448": "1003", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "1000", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"comment": "fields here and become the group again on the way in",
     "expect": "broker",
     "fields": {"35": "8", "11": "BIN-A1", "150": "0", "39": "0",
                "151": "1000", "48": "700", "38": "1000", "1093": "2"}},

    {"comment": "The order is on the same book every other encoding sees",
     "control": "bbo", "args": {"market": "MAIN", "symbol": "700"},
     "expect_result": {"bid": "393.000", "bid_qty": 1000}},

    {"comment": "A FIX broker sells into it: one book, two encodings",
     "send": "fixbroker",
     "fields": {"35": "D", "11": "BIN-F1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG",
                "40": "2", "54": "2", "38": "1000", "44": "393.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "fixbroker",
     "fields": {"35": "8", "11": "BIN-F1", "150": "F", "39": "2",
                "32": "1000", "31": "393.000"}},
    {"comment": "The binary side is told the same trade in its own spelling",
     "expect": "broker",
     "fields": {"35": "8", "11": "BIN-A1", "150": "F", "39": "2",
                "32": "1000", "31": "393"}},

    {"comment": "An amend, then a cancel that names the current ClOrdID",
     "send": "broker",
     "fields": {"35": "D", "11": "BIN-A2",
                "453": "1", "448": "1003", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "1000", "44": "392.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker", "fields": {"35": "8", "11": "BIN-A2", "150": "0"}},
    {"send": "broker",
     "fields": {"35": "G", "11": "BIN-A3", "41": "BIN-A2",
                "453": "1", "448": "1003", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "2000", "44": "392.200",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "BIN-A3", "41": "BIN-A2", "150": "5",
                "38": "2000", "44": "392.2"}},

    {"comment": "A refused cancel is an Execution Report here, not a 35=9:",
     "send": "broker",
     "fields": {"35": "F", "11": "BIN-A4", "41": "NOSUCHORDER",
                "453": "1", "448": "1003", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG", "54": "1"}},
    {"comment": "ExecType X, carrying the running totals 35=9 has no room for",
     "expect": "broker",
     "fields": {"35": "8", "11": "BIN-A4", "150": "X", "102": "1",
                "14": "0", "151": "0"}},

    {"comment": "A message only the venue may send is refused, and the session",
     "send": "broker", "fields": {"35": "j", "380": "0"}},
    {"comment": "survives it -- MessageRejectCode 11, invalid message type",
     "expect": "broker", "fields": {"35": "3", "373": "11"}},

    {"send": "broker",
     "fields": {"35": "F", "11": "BIN-A5", "41": "BIN-A3",
                "453": "1", "448": "1003", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG", "54": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "BIN-A5", "41": "BIN-A3", "150": "4",
                "39": "4", "151": "0"}},

    {"comment": "and the audit knows which encoding each entry arrived in",
     "control": "audit", "args": {"limit": 5, "kind": "fix"}},

    {"control": "orders.cancel_all", "args": {"text": "scenario teardown"}},
    {"logout": "fixbroker"},
    {"logout": "broker"}
  ]
}
