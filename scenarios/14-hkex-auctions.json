{
  "name": "HKEX: the pre-opening and closing auctions",

  "begin_string": "FIXT.1.1",
  "fix_port": 9011,
  "control_port": 9102,
  "server_comp_id": "HKEXSIM",
  "logon_reset_flag": false,
  "logon_fields": {"789": "1", "1137": "9", "1400": "101", "1402": "c2ltdWxhdG9y"},

  "sessions": {
    "buyer": {"comp_id": "BROKER1"},
    "seller": {"comp_id": "BROKER2"}
  },

  "steps": [
    {"control": "orders.cancel_all", "args": {"text": "scenario setup"}},
    {"control": "session.reset", "args": {"target_comp_id": "BROKER1"}},
    {"control": "session.reset", "args": {"target_comp_id": "BROKER2"}},

    {"comment": "PRE_OPEN opens the pre-opening session over the whole segment",
     "control": "state.set", "args": {"market": "MAIN", "state": "PRE_OPEN"}},
    {"control": "auction", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"auction": "POS", "stage": "INPUT",
                       "cancellable": true, "reference_price": "395.800",
                       "price_low": "336.430", "price_high": "455.170"}},

    {"logon": "buyer"},
    {"logon": "seller"},
    {"clear": "buyer"},
    {"clear": "seller"},

    {"comment": "An at-auction limit order: accepted, but nothing matches yet",
     "send": "buyer",
     "fields": {"35": "D", "11": "AU-B1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "1000", "44": "396.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "buyer", "fields": {"35": "8", "11": "AU-B1", "150": "0"}},

    {"send": "seller",
     "fields": {"35": "D", "11": "AU-S1",
                "453": "1", "448": "1002", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "2", "38": "600", "44": "395.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "seller", "fields": {"35": "8", "11": "AU-S1", "150": "0"}},
    {"comment": "the book is legitimately crossed and still nothing trades",
     "expect_none": "buyer", "fields": {"150": "F"}, "for": 0.4},

    {"comment": "An at-auction order carries no price at all (OrdType 1)",
     "send": "buyer",
     "fields": {"35": "D", "11": "AU-B2",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "1", "54": "1", "38": "500",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"comment": "it rests instead of expiring, which it would in continuous trading",
     "expect": "buyer", "fields": {"35": "8", "11": "AU-B2", "150": "0",
                                   "151": "500"}},

    {"comment": "Both prices trade 600 and leave 900 unfilled, so the buy surplus decides",
     "control": "auction", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"iep": "396.000", "iev": 600, "imbalance": 900,
                       "imbalance_side": "BUY",
                       "reason": "buy surplus, highest price"}},

    {"comment": "An order outside the +/-15% band is refused",
     "send": "buyer",
     "fields": {"35": "D", "11": "AU-B3",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "300.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "buyer", "fields": {"35": "8", "11": "AU-B3", "150": "8",
                                   "103": "16"}},

    {"comment": "Locking ends the input period and pins the band to the book",
     "control": "auction.lock", "args": {"market": "MAIN"},
     "expect_result": {"auction": "POS", "stage": "LOCKED"}},
    {"control": "auction", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"stage": "LOCKED", "cancellable": false,
                       "price_low": "395.000", "price_high": "396.000"}},

    {"comment": "and cancellation is refused for as long as it lasts",
     "send": "buyer",
     "fields": {"35": "F", "11": "AU-B4", "41": "AU-B1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "54": "1", "38": "1000"}},
    {"expect": "buyer", "fields": {"35": "9", "11": "AU-B4", "102": "0"}},

    {"comment": "Opening the market uncrosses: one price for everybody",
     "control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},
    {"comment": "the at-auction order is filled ahead of the limit order",
     "expect": "buyer", "fields": {"35": "8", "11": "AU-B2", "150": "F",
                                   "31": "396.000", "32": "500", "39": "2"}},
    {"expect": "buyer", "fields": {"35": "8", "11": "AU-B1", "150": "F",
                                   "31": "396.000", "32": "100", "39": "1"}},
    {"expect": "seller", "fields": {"35": "8", "11": "AU-S1", "150": "F",
                                    "31": "396.000", "39": "2"}},
    {"comment": "and an auction trade has no aggressor",
     "expect": "seller", "fields": {"35": "8", "11": "AU-S1", "1057": "N"}},

    {"comment": "the unfilled balance is carried into continuous trading",
     "control": "bbo", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"bid": "396.000", "bid_qty": 900}},

    {"clear": "buyer"},
    {"clear": "seller"},

    {"comment": "CAS anchors on the last traded price, not the previous close",
     "control": "state.set",
     "args": {"market": "MAIN", "state": "CLOSING_AUCTION"}},
    {"control": "auction", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"auction": "CAS", "reference_price": "396.000",
                       "price_low": "376.200", "price_high": "415.800"}},

    {"comment": "A one-sided book forms no IEP, so the reference price stands in",
     "control": "orders.cancel_all", "args": {"text": "clear the carried book"}},
    {"clear": "buyer"},
    {"clear": "seller"},

    {"send": "buyer",
     "fields": {"35": "D", "11": "AU-B5",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "1", "54": "1", "38": "300",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"send": "seller",
     "fields": {"35": "D", "11": "AU-S2",
                "453": "1", "448": "1002", "447": "D", "452": "1",
                "48": "00700", "22": "8", "207": "XHKG",
                "40": "2", "54": "2", "38": "300", "44": "390.000",
                "1812": "1", "1813": "100", "1814": "1"}},
    {"clear": "buyer"},
    {"clear": "seller"},

    {"control": "auction", "args": {"market": "MAIN", "symbol": "00700"},
     "expect_result": {"iep": null, "reason": "book does not cross"}},

    {"control": "state.set", "args": {"market": "MAIN", "state": "CLOSED"}},
    {"comment": "matched at the reference price, which becomes the close",
     "expect": "buyer", "fields": {"35": "8", "11": "AU-B5", "150": "F",
                                   "31": "396.000", "32": "300"}},
    {"expect": "seller", "fields": {"35": "8", "11": "AU-S2", "150": "F",
                                    "31": "396.000", "32": "300"}},

    {"control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},
    {"control": "orders.cancel_all", "args": {"text": "scenario teardown"}},
    {"logout": "buyer"},
    {"logout": "seller"}
  ]
}
