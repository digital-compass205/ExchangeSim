{
  "name": "Audit: the tape records both the wire and the control plane",

  "begin_string": "FIXT.1.1",
  "fix_port": 9012,
  "control_port": 9102,
  "server_comp_id": "HKEXSIM",
  "logon_reset_flag": false,
  "logon_fields": {"789": "1", "1137": "9", "1400": "101", "1402": "c2ltdWxhdG9y"},

  "sessions": {
    "broker": {"comp_id": "BROKER1"}
  },

  "steps": [
    {"control": "orders.cancel_all", "args": {"text": "scenario setup"}},
    {"control": "session.reset", "args": {"target_comp_id": "BROKER1"}},
    {"control": "state.set", "args": {"market": "MAIN", "state": "OPEN"}},

    {"logon": "broker"},
    {"clear": "broker"},

    {"comment": "A resting order, whose every step should appear on the tape",
     "send": "broker",
     "fields": {"35": "D", "11": "AUD-1",
                "453": "1", "448": "1001", "447": "D", "452": "1",
                "48": "700", "22": "8", "207": "XHKG",
                "40": "2", "54": "1", "38": "100", "44": "390.000",
                "59": "0", "1812": "1", "1813": "100", "1814": "1"}},
    {"expect": "broker",
     "fields": {"35": "8", "11": "AUD-1", "150": "0", "39": "0"}},

    {"comment": "What the client sent, recorded against the security it names",
     "control": "audit",
     "args": {"symbol": "700", "kind": "fix", "direction": "in",
              "types": ["D"], "limit": 50},
     "expect_contains": {"entries": {"type": "D", "type_name": "NewOrderSingle",
                                     "symbol": "700", "direction": "in",
                                     "kind": "fix", "session": "BROKER1",
                                     "ok": true}}},

    {"comment": "and what the venue answered, recorded as the other direction",
     "control": "audit",
     "args": {"symbol": "700", "kind": "fix", "direction": "out",
              "types": ["8"], "limit": 50},
     "expect_contains": {"entries": {"type": "8",
                                     "type_name": "ExecutionReport",
                                     "symbol": "700", "direction": "out"}}},

    {"comment": "The Logon is session-level: no instrument, and shown anyway",
     "control": "audit",
     "args": {"symbol": "700", "types": ["A"], "limit": 50},
     "expect_contains": {"entries": {"type": "A", "type_name": "Logon",
                                     "symbol": null}}},

    {"comment": "An order entered through the control plane is on the same tape",
     "control": "order.new",
     "args": {"market": "MAIN", "symbol": "700", "side": "SELL",
              "quantity": 100, "price": "395.000", "tif": "DAY",
              "owner": "AUDIT", "cl_ord_id": "AUD-2"}},
    {"control": "audit",
     "args": {"kind": "control", "types": ["order.new"], "limit": 50},
     "expect_contains": {"entries": {"type": "order.new", "kind": "control",
                                     "symbol": "700", "direction": "in",
                                     "ok": true}}},

    {"comment": "A command the venue refused is recorded as having failed",
     "control": "state.set",
     "args": {"market": "NOSUCH", "state": "OPEN"},
     "expect_error": "not_found"},
    {"control": "audit",
     "args": {"kind": "control", "types": ["state.set"], "limit": 50},
     "expect_contains": {"entries": {"type": "state.set", "ok": false}}},

    {"comment": "The filter vocabulary is the venue's own dialect",
     "control": "audit.types",
     "expect_contains": {"msg_types": {"type": "D",
                                       "name": "NewOrderSingle",
                                       "inbound": true}}},

    {"comment": "and the commands it lists are the ones it actually records",
     "control": "audit.types",
     "expect_contains": {"commands": "order.new"}},

    {"comment": "The tape is bounded and says so, and this run has not lost any",
     "control": "audit",
     "args": {"symbol": "700", "limit": 500},
     "expect_result": {"truncated": false, "capacity": 2000}},

    {"control": "orders.cancel_all", "args": {"text": "scenario teardown"}},
    {"logout": "broker"}
  ]
}
