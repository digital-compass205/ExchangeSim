{
  "name": "NSE F&O: a future and an option, and everything this venue refuses",
  "protocol": "nnf",
  "dialect": "nsefo",
  "fix_port": 9031,
  "control_port": 9104,
  "server_comp_id": "NSEFO-SIM",
  "sessions": {
    "one": {
      "comp_id": "50521",
      "protocol": "nnf"
    },
    "two": {
      "comp_id": "50777",
      "protocol": "nnf"
