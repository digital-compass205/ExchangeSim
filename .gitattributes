# The deployment target is RHEL 8; development happens on Windows. Normalise
# everything to LF in the repository and on checkout so files copied to the
# server never carry CRLF.
* text=auto eol=lf

# Binary assets must not be touched.
*.pdf binary
*.pcap binary

# cmd.exe mis-parses a parenthesised block in a batch file with LF endings, so
# the one Windows wrapper is the exception to the rule above.
*.cmd text eol=crlf
